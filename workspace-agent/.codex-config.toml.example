# Merged with ~/.codex/config.toml when Codex runs in C:\git.

[mcp_servers.super-mcp]
command = 'C:\Users\brillix\AppData\Roaming\npm\super-mcp-router.cmd'
args = ["--config", 'C:\Users\brillix\.super-mcp\config.json']
cwd = 'C:\git'
startup_timeout_sec = 60
tool_timeout_sec = 300

[mcp_servers.myoracle]
command = 'C:\git\oracle_single\myoracle_mcp\.venv\Scripts\python.exe'
args = ['C:\git\oracle_single\myoracle_mcp\server.py']
cwd = 'C:\git\oracle_single'
startup_timeout_sec = 60
tool_timeout_sec = 300

[mcp_servers.myoracle.env]
PYTHONIOENCODING = "utf-8"
